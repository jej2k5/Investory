# Stock data provider — set one of the two keys below.
# When MASSIVE_API_KEY is set it takes precedence over Alpha Vantage.

# Alpha Vantage API Key (default provider)
# Get your free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=demo

# Massive.com API Key (formerly Polygon.io — alternative provider)
# Get a key at: https://massive.com
# Leave blank to use Alpha Vantage instead.
MASSIVE_API_KEY=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investory

# For production, use a secure password:
# DATABASE_URL=postgresql://username:securepassword@hostname:5432/dbname

# Authentication Configuration
# IMPORTANT: Change this to a secure random string in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
