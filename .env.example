# Docker Compose Environment Variables
# Copy this file to .env and update with your values

# Database Configuration
DB_NAME=investory
DB_USER=<change-me>
DB_PASSWORD=<change-me>
DB_PORT=5432

# API Configuration
DATABASE_URL=<change-me>
# Stock data providers — set one (Massive takes precedence when both are set)
ALPHA_VANTAGE_KEY=<change-me>
# Massive.com API key (formerly Polygon.io). Get a key at https://massive.com
# When set, Massive is used instead of Alpha Vantage to retrieve stock data.
MASSIVE_API_KEY=
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# pgAdmin Configuration (optional)
PGADMIN_EMAIL=<change-me>
PGADMIN_PASSWORD=,change-me>
PGADMIN_PORT=5050
